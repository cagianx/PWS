<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PWS.App.Linux</RootNamespace>
    <AssemblyName>PWS.App.Linux</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!--
      Microsoft.Maui.Platforms.Linux.Gtk4 (dotnet/maui-labs) porta con sé
      Microsoft.Maui.Controls (10.0.x) e i binding GirCore per GTK4.
      Non serve il workload MAUI tradizionale.
      Per buildare senza il workload rotto usare:
        MSBuildEnableWorkloadResolver=false dotnet build
      oppure aggiungere la env var al proprio shell profile.
    -->
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <EnableDefaultXamlItems>false</EnableDefaultXamlItems>
  </PropertyGroup>

  <!-- Package: backend GTK4 ufficiale per MAUI su Linux (dotnet/maui-labs).
       Sperimentale: versione preview fissata in modo esatto, ogni aggiornamento
       è un commit chore(deps) dedicato. Essentials non è referenziato perché
       l'app non registra né usa servizi Essentials.
       0.1.0-ci.821.1 è il pacchetto della PR dotnet/maui-labs#594 (corregge il resize),
       servito dal feed locale packages/local (vedi NuGet.config). Da sostituire con la
       prima preview su nuget.org che include la PR. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Platforms.Linux.Gtk4" Version="0.1.0-ci.821.1" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <!-- Riferimento al progetto core (nessuna dipendenza MAUI) -->
  <ItemGroup>
    <ProjectReference Include="../PWS.Core/PWS.Core.csproj" />
  </ItemGroup>

  <!-- File XAML del layer UI
       NOTA: con EnableDefaultXamlItems=false usare Include (non Update)
             altrimenti i file non vengono aggiunti al progetto e InitializeComponent
             non viene generato. -->
  <ItemGroup>
    <MauiXaml Include="App.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Include="AppShell.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Include="Pages\BrowserPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Include="Pages\ErrorPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Include="Pages\StartupPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Include="Resources\Styles\Colors.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Include="Resources\Styles\Styles.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
  </ItemGroup>

</Project>

