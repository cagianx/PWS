<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PWS.IntegrationTests</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!--
      Test di integrazione attraverso i confini reali del sistema: file .pws su disco,
      socket HTTP su loopback, comandi della CLI. Nessun mock.
      Vedi my-docs/docs/regole/testing.md.
      Nessuna dipendenza MAUI/GTK: gira su qualunque runner Linux.
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="NUnit"                  Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter"      Version="6.3.0" />
    <PackageReference Include="FluentAssertions"       Version="8.11.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../PWS.Format/PWS.Format.csproj" />
    <ProjectReference Include="../PWS.Core/PWS.Core.csproj" />
    <ProjectReference Include="../PWS.Tool/PWS.Tool.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
    <Using Include="FluentAssertions" />
  </ItemGroup>

</Project>
